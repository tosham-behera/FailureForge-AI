# FailureForge AI - files that MUST NOT be committed
# Keep backend/.env and any frontend/.env.* local. Commit .env.example as a template.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Private keys, certificates, cloud credentials, and local token stores
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa
id_ed25519
**/credentials.json
**/service-account*.json
**/service_account*.json
**/secrets.json
**/token.json
**/.aws/
**/.azure/
**/.config/gcloud/

# Python: virtual environments, caches, local state, test results
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.sqlite3

# Node / Vite: installed dependencies and generated builds
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Logs, OS, editor, and temporary files
*.log
logs/
*.tmp
.DS_Store
Thumbs.db
.vscode/
.idea/
